---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Privacy Policy | Guangxi Province"
  description="Privacy policy for the Guangxi Province Travel Guide."
  noindex={true}
>
  <Nav solid />
  <main class="pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-stone-900 pb-1">Privacy Policy</h1>
      <div class="mt-8 space-y-5 text-stone-600 leading-relaxed">
        <p>
          This site is a static travel guide. We do not run accounts, collect personal data, or require registration.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">Analytics</h2>
        <p>
          If we enable analytics, we use privacy-respecting, aggregate metrics to understand which pages are useful. We do not sell or share any visitor data.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">Email</h2>
        <p>
          If you contact us by email, we use your address only to reply to your message. We do not add it to any list.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">External links</h2>
        <p>
          This site links to external resources such as Unsplash for imagery. We are not responsible for the privacy practices of linked websites.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
