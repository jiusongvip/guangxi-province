---
const stayTypes = [
  { type: "International hotels", price: "CNY 400-900", img: "/images/stay/stay-hotel.webp", alt: "A hotel in Guilin", note: "Familiar brands in Guilin, Nanning and Beihai city centers. Reliable, English-speaking front desks and easy taxis." },
  { type: "Boutique & courtyard stays", price: "CNY 300-700", img: "/images/stay/stay-boutique.webp", alt: "Stone lanes and courtyard inns inside Huangyao", note: "Converted riverside houses in Guilin and Yangshuo, and stone courtyard inns inside Huangyao. The character option." },
  { type: "Countryside guesthouses", price: "CNY 150-400", img: "/images/stay/stay-guesthouse.webp", alt: "Yangshuo villages and fields between the karst peaks", note: "Family-run inns in Yangshuo's villages, Longji's terrace villages and the Mingshi valley. Basic English, huge views." },
  { type: "Special stays", price: "CNY 200-600", img: "/images/stay/stay-special.webp", alt: "Wooden stilt guesthouses above the Longsheng rice terraces", note: "Wooden Yao guesthouses above the Longji terraces, and Weizhou Island homestays that will cook your market seafood." },
];

const areaAdvice = [
  { place: "Guilin", tip: "Stay near the Two Rivers and Four Lakes or the pedestrian streets for the night cruise. Guilin is a base, not a destination — two nights is enough." },
  { place: "Yangshuo", tip: "Skip the noisy West Street core. Choose a guesthouse in the villages along the Yulong River for karst views, free bikes and quiet." },
  { place: "Longji", tip: "Sleep on the mountain in Ping'an or Jinkeng, not at the valley bus stop. The sunrise over the flooded terraces is the entire reason to stay." },
  { place: "Beihai & Weizhou", tip: "Beihai: Silver Beach or the old town. On Weizhou, book a homestay that offers a market-cooking service — it is the best meal deal in Guangxi." },
  { place: "Chongzuo", tip: "Base in Chongzuo city for the Detian day trip, or stay in the Mingshi valley for quieter karst countryside and river views." },
  { place: "Huangyao & Hechi", tip: "In Huangyao, stay inside the old town walls; the town empties after the day-trippers leave. In Hechi, keep expectations basic and book ahead in peak weeks." },
];

const bookingTips = [
  "Book through Trip.com (the English version of Ctrip), Booking.com or Agoda. All handle foreign cards and passport check-in.",
  "In rural areas, guesthouses often are not on international platforms. Message them on WeChat or book through a local driver for a small fee.",
  "Ask for a quiet room: West Street in Yangshuo and the ferry-pier area in Beihai can be loud after dark.",
  "In peak season (October and Chinese holidays), book Longji and Weizhou Island at least a week ahead; both have limited beds.",
  "Many guesthouses will arrange the Li River cruise, Longji transfers and scooter rentals for the same price or less than online.",
];
---
<section id="stay" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Where to stay in Guangxi
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        From international hotels to wooden terrace inns, Guangxi's best beds are often its simplest. Here is how to choose, area by area.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
      {stayTypes.map((s) => (
        <div class="card rounded-2xl overflow-hidden flex flex-col">
          <div class="card-img relative aspect-[4/3] overflow-hidden">
            <img src={s.img} alt={s.alt} class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <p class="font-semibold text-stone-900">{s.type}</p>
            <p class="text-xs font-medium text-brand-800 mt-1">{s.price}</p>
            <p class="text-sm text-stone-600 mt-3 leading-relaxed">{s.note}</p>
          </div>
        </div>
      ))}
    </div>

    <details class="bg-white rounded-2xl border border-stone-200 overflow-hidden mb-6 group">
      <summary class="cursor-pointer flex items-center justify-between px-7 py-5 text-lg font-bold text-stone-900 list-none">
        Where to stay in each area
        <svg class="w-5 h-5 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="px-7 pb-7 space-y-5">
        {areaAdvice.map((a) => (
          <div>
            <p class="font-semibold text-stone-900">{a.place}</p>
            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed">{a.tip}</p>
          </div>
        ))}
      </div>
    </details>

    <details class="bg-white rounded-2xl border border-stone-200 overflow-hidden group">
      <summary class="cursor-pointer flex items-center justify-between px-7 py-5 text-lg font-bold text-stone-900 list-none">
        Booking tips for foreign travelers
        <svg class="w-5 h-5 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="px-7 pb-7">
        <ul class="space-y-3">
          {bookingTips.map((t) => (
            <li class="flex gap-3 text-sm text-stone-600 leading-relaxed">
              <svg class="w-5 h-5 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>
</section>
