---
const spine = [
  { name: "Guilin", chinese: "桂林", tag: "North · karst gateway", note: "The usual entry point. Li River cruise, Elephant Trunk Hill, and the launchpad for Yangshuo and Longji." },
  { name: "Liuzhou", chinese: "柳州", tag: "Central · food city", note: "Luosifen's birthplace, an easy one-hour rail hop south of Guilin on the way to Nanning." },
  { name: "Nanning", chinese: "南宁", tag: "South · capital & rail hub", note: "The capital and transfer point: branch southwest to Chongzuo, or continue south to Beihai." },
  { name: "Beihai", chinese: "北海", tag: "South coast · beach & island", note: "Silver Beach and the ferry to Weizhou Island, the end of the line." },
];

const branches = [
  { name: "Longji Rice Terraces", chinese: "龙脊梯田", rel: "2 h north of Guilin", note: "Zhuang and Yao villages above flooded, mirror-like terraces." },
  { name: "Yangshuo", chinese: "阳朔", rel: "65 km south of Guilin", note: "Li River bamboo rafts, Ten-Mile Gallery cycling and karst climbing." },
  { name: "Huangyao Ancient Town", chinese: "黄姚古镇", rel: "East, near Hezhou", note: "A lived-in 1,000-year-old town of stone lanes and covered bridges." },
  { name: "Chongzuo & Detian", chinese: "崇左德天", rel: "3 h southwest of Nanning", note: "Asia's largest transnational waterfall on the Vietnam border." },
  { name: "Hechi & Bama", chinese: "河池巴马", rel: "Northwest corner", note: "Raw karst: sinkholes, underground rivers and blue cave lakes." },
];
---
<section id="map" class="py-20 md:py-28 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Where everything is
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Guangxi hangs on one north-south rail spine: Guilin to Liuzhou to Nanning to Beihai. Every other destination branches off it. This is the mental map.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-800 mb-5">The rail spine · north to south</p>
        <div class="border-l-2 border-dashed border-brand-300 pl-7 space-y-7">
          {spine.map((s) => (
            <div class="relative">
              <span class="absolute -left-[37px] top-1.5 w-3.5 h-3.5 rounded-full bg-brand-600 border-2 border-white"></span>
              <p class="text-xs font-semibold text-brand-800 uppercase tracking-wider">{s.tag}</p>
              <h3 class="text-lg font-bold text-stone-900 mt-1">{s.name} <span class="text-stone-600 font-medium text-base">{s.chinese}</span></h3>
              <p class="text-sm text-stone-600 mt-1.5 leading-relaxed">{s.note}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-800 mb-5">Branches off the spine</p>
        <div class="space-y-4">
          {branches.map((b) => (
            <div class="bg-white rounded-xl border border-stone-200 p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-bold text-stone-900">{b.name} <span class="text-stone-600 font-medium text-sm">{b.chinese}</span></h3>
                <span class="text-xs font-medium text-brand-800 whitespace-nowrap shrink-0">{b.rel}</span>
              </div>
              <p class="text-sm text-stone-600 mt-2 leading-relaxed">{b.note}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <p class="text-sm text-stone-500 mt-8 leading-relaxed max-w-3xl">
      <span class="font-semibold text-stone-700">How to use this:</span> start in Guilin, ride the spine south, and add the branches that match your time. The classic 7-day loop is Guilin → Yangshuo → Liuzhou → Nanning → Chongzuo → Beihai.
    </p>
  </div>
</section>
