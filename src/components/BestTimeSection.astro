---
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const highs = [11, 13, 17, 23, 27, 30, 33, 33, 30, 25, 19, 14];
const lows = [5, 7, 11, 16, 21, 24, 26, 25, 22, 17, 12, 8];

const seasons = [
  {
    when: "Oct to April",
    label: "The sweet spot",
    body: "Dry and mild across the coast and the karst. The best overall window for Guilin, Yangshuo, Beihai and the terraces.",
    good: true,
  },
  {
    when: "April to June",
    label: "Terraces mirror season",
    body: "Longji's paddies are flooded with water, turning them into reflective mirrors at sunrise. Spring greenery across the region.",
    good: true,
  },
  {
    when: "June to October",
    label: "Waterfall season",
    body: "Detian Waterfall runs at full flow after the rains. Hot and humid elsewhere, but the borderland is at its best.",
    good: false,
  },
  {
    when: "September to October",
    label: "Golden harvest",
    body: "The Longji terraces turn gold before the autumn harvest. A second peak window for photographers.",
    good: true,
  },
];
---
<section id="best-time" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
          When to go
        </h2>
        <p class="text-stone-500 text-lg mt-4 leading-relaxed">
          Guangxi has no hard winter and no altitude, so there is almost always a good reason to be here. The one rule: avoid the rainy May and the humid peak of July and August unless you are chasing waterfalls.
        </p>
      </div>
      <div class="lg:col-span-7 space-y-4">
        {seasons.map((s) => (
          <div class="flex gap-5 p-5 rounded-xl border border-stone-200">
            <div class="shrink-0 w-32">
              <p class="text-sm font-semibold text-stone-900">{s.when}</p>
            </div>
            <div>
              <p class="font-semibold text-stone-900">{s.label}</p>
              <p class="text-sm text-stone-600 mt-1 leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-lg font-bold text-stone-900">Guilin monthly climate</h3>
      <p class="text-sm text-stone-500 mt-1 mb-5 max-w-2xl leading-relaxed">
        Approximate monthly averages for Guilin, from public long-term weather records. The coast (Beihai) runs a few degrees warmer in winter; the borderland (Chongzuo) stays warmer year-round.
      </p>
      <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-b border-stone-200 bg-stone-50">
              <th class="py-3 px-4 font-semibold text-stone-900">Month</th>
              {months.map((m) => <th class="py-3 px-2 font-semibold text-stone-700">{m}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-stone-100">
              <td class="py-3 px-4 font-medium text-stone-700">Avg high (°C)</td>
              {highs.map((h) => <td class="py-3 px-2 text-stone-600">{h}</td>)}
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-stone-700">Avg low (°C)</td>
              {lows.map((l) => <td class="py-3 px-2 text-stone-600">{l}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
