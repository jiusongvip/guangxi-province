---
const titleText = "Guangxi Province, Beyond Guilin";
---
<section class="hero-stage">
  <div class="hero-bg">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/guangxi-hero-1000.webp" width="1000" height="562" />
      <img
        src="/images/guangxi-hero.webp"
        alt="Li River karst peaks rising from the water near Guilin, Guangxi"
        width="1672"
        height="941"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </div>
  <canvas class="hero-particles" id="hero-particles" aria-hidden="true"></canvas>

  <div class="hero-content">
    <p class="overline">Guangxi · Southwest China · 2026</p>
    <h1 id="hero-title" class="hero-title text-5xl md:text-7xl lg:text-8xl">
      {titleText.split("").map((ch, i) => (
        <span class="split-char" style={`--d:${(0.02 + i * 0.004).toFixed(3)}s`}>{ch === " " ? "\u00a0" : ch}</span>
      ))}
    </h1>
    <p class="hero-sub text-base md:text-lg leading-relaxed">
      Karst peaks, a volcanic island, a Vietnam-border waterfall and the world's favorite noodle soup.
      <span class="font-semibold text-white">One page. No ten tabs. Read it and book.</span>
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="#matcher" class="btn-outline btn-outline-dark">Find your match</a>
      <a href="#itineraries" class="btn-outline btn-outline-dark">See the 7-day route</a>
    </div>

    <p class="hero-meta">
      <span>By the Guangxi Guide Team</span>
      <span aria-hidden="true">·</span>
      <span>Updated August 2026</span>
      <span aria-hidden="true">·</span>
      <span>Firsthand trips across all 14 prefectures</span>
    </p>
  </div>

  <div class="hero-scroll" aria-hidden="true"></div>
</section>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Particle stage — floating leaf-green embers over the hero
    var canvas = document.getElementById("hero-particles");
    if (canvas && !reduce) {
      var ctx = canvas.getContext("2d");
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w, h, particles = [];

      var colors = ["rgba(99,175,140,", "rgba(193,203,129,", "rgba(255,253,243,"];

      function resize() {
        var rect = canvas.parentElement.getBoundingClientRect();
        w = rect.width; h = rect.height;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + "px"; canvas.style.height = h + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function spawn(p) {
        p.x = Math.random() * w;
        p.y = Math.random() * h;
        p.r = 0.6 + Math.random() * 1.8;
        p.vy = -(0.08 + Math.random() * 0.28);
        p.vx = (Math.random() - 0.5) * 0.12;
        p.a = 0.12 + Math.random() * 0.4;
        p.c = colors[Math.floor(Math.random() * colors.length)];
        p.tw = Math.random() * Math.PI * 2;
      }
      function init() {
        resize();
        var count = Math.min(50, Math.floor(w / 26));
        particles = [];
        for (var i = 0; i < count; i++) {
          var p = {}; spawn(p); particles.push(p);
        }
      }
      function frame() {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.x += p.vx; p.y += p.vy; p.tw += 0.008;
          p.a = 0.12 + Math.random() * 0.3;
          if (p.y < -10) spawn(p);
          if (p.x < -10) p.x = w + 10; if (p.x > w + 10) p.x = -10;
          ctx.beginPath();
          ctx.fillStyle = p.c + (p.a * (0.5 + 0.5 * Math.sin(p.tw))).toFixed(3) + ")";
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        requestAnimationFrame(frame);
      }
       setTimeout(function () {
         requestAnimationFrame(function () {
           init();
           requestAnimationFrame(frame);
         });
       }, 1200);
       var onResize;
      window.addEventListener("resize", function () { clearTimeout(onResize); onResize = setTimeout(init, 200); }, { passive: true });
    }
  })();
</script>
