---
import { destinations } from "../data/destinations";
---
<section id="destinations" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Eight places worth planning around
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        The essentials, in rough geographic order from north to south. Each card tells you how long to stay and who it is for.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {destinations.map((d) => (
        <article class="dest-card bg-stone-50 rounded-2xl overflow-hidden border border-stone-200 flex flex-col">
          <div class="relative overflow-hidden aspect-[16/9]">
            <img src={d.image} alt={`${d.name} ${d.chinese}, Guangxi`} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            <div class="absolute top-4 left-4 px-3 py-1 bg-brand-900/90 text-white text-xs font-semibold rounded-full">{d.minDays}</div>
          </div>
          <div class="p-6 md:p-7 flex flex-col flex-1">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-xl md:text-2xl font-bold text-stone-900">{d.name} <span class="text-stone-600 font-medium text-base">{d.chinese}</span></h3>
            </div>
            <p class="text-sm text-stone-600 mt-0.5">{d.region}</p>
            <p class="text-brand-800 font-medium mt-3">{d.tagline}</p>
            <p class="text-stone-600 text-sm mt-3 leading-relaxed">{d.overview}</p>

            <div class="mt-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">Highlights</p>
              <ul class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5">
                {d.highlights.slice(0, 4).map((h) => (
                  <li class="text-sm text-stone-600 flex gap-2"><span class="text-brand-600 mt-0.5">-</span>{h}</li>
                ))}
              </ul>
            </div>

            <div class="mt-5 bg-white rounded-xl border border-stone-200 p-4">
              <p class="text-sm text-stone-600 italic leading-relaxed">{d.experienceNote}</p>
            </div>

            <div class="mt-5 space-y-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">Eat this</p>
                {d.namedFoods.map((f) => (
                  <p class="text-sm text-stone-600 mt-1.5 leading-relaxed"><span class="font-medium text-stone-800">{f.name}</span> <span class="text-stone-600">({f.price})</span> - {f.why}</p>
                ))}
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">Know before you go</p>
                {d.localWarnings.map((w) => (
                  <p class="text-sm text-stone-600 mt-1.5 leading-relaxed"><span class="font-medium text-stone-800">{w.title}:</span> {w.detail}</p>
                ))}
              </div>
            </div>

            <div class="mt-5 pt-4 border-t border-stone-200 flex items-center justify-between gap-3">
              <p class="text-sm text-stone-500"><span class="font-medium text-stone-700">Best for:</span> {d.bestFor}</p>
            </div>

            <details class="mt-4 pt-4 border-t border-stone-200 group">
              <summary class="cursor-pointer flex items-center justify-between text-sm font-semibold text-brand-800 list-none">
                Climate, transport and where to stay
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="mt-4 space-y-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">Climate</p>
                  <p class="text-sm text-stone-600 mt-1 leading-relaxed">{d.climate}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">How to get there</p>
                  <p class="text-sm text-stone-600 mt-1 leading-relaxed">{d.transport.howToGet}</p>
                  <p class="text-sm text-stone-600 mt-1 leading-relaxed"><span class="font-medium text-stone-800">Train:</span> {d.transport.byTrain}</p>
                  <p class="text-sm text-stone-600 mt-1 leading-relaxed"><span class="font-medium text-stone-800">Flight:</span> {d.transport.byFlight}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">Where to stay</p>
                  {d.accommodation.map((a) => (
                    <p class="text-sm text-stone-600 mt-1.5 leading-relaxed"><span class="font-medium text-stone-800">{a.type}</span> ({a.priceRange}) - {a.detail}</p>
                  ))}
                </div>
                {d.dayPlans.map((dp) => (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-stone-600">A sample {dp.label.toLowerCase()}</p>
                    <ul class="mt-1.5 space-y-1">
                      {dp.steps.map((s) => (
                        <li class="text-sm text-stone-600 flex gap-2 leading-relaxed"><span class="text-brand-600 mt-0.5">-</span>{s}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
