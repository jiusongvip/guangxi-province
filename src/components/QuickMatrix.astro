---
import { destinations } from "../data/destinations";

// Rough mid-range daily budget floor per destination, aligned with the BudgetCalculator tiers.
const budgetHint: Record<string, string> = {
  guilin: "CNY 400+",
  yangshuo: "CNY 300+",
  "longji-rice-terraces": "CNY 250+",
  "beihai-weizhou-island": "CNY 300+",
  "chongzuo-detian-waterfall": "CNY 250+",
  liuzhou: "CNY 250+",
  "huangyao-ancient-town": "CNY 250+",
  "bama-hechi": "CNY 200+",
};
---
<section class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        The at-a-glance decision table
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Destination, days, daily budget and who it suits, in one table. If you only read one thing, read this.
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-stone-200">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead>
          <tr class="bg-stone-50 border-b border-stone-200">
            <th class="px-5 py-4 font-semibold text-stone-900">Destination</th>
            <th class="px-5 py-4 font-semibold text-stone-900">Stay</th>
            <th class="px-5 py-4 font-semibold text-stone-900">Daily budget</th>
            <th class="px-5 py-4 font-semibold text-stone-900">Best for</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {destinations.map((d) => (
            <tr class="hover:bg-brand-50/40">
              <td class="px-5 py-4">
                <span class="font-semibold text-stone-900">{d.name}</span>
                <span class="text-stone-600 font-medium"> {d.chinese}</span>
              </td>
              <td class="px-5 py-4 text-stone-600 whitespace-nowrap">{d.minDays}</td>
              <td class="px-5 py-4 text-stone-600 whitespace-nowrap">{budgetHint[d.slug]}</td>
              <td class="px-5 py-4 text-stone-600">{d.bestFor}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-xs text-stone-600 mt-4">
      Daily budgets are mid-range per person, excluding the Li River cruise and Weizhou ferry. See the calculator below for a full estimate.
    </p>
  </div>
</section>
