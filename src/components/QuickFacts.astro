---
const facts = [
  {
    icon: "calendar",
    label: "Best Season",
    value: "Oct to April",
    note: "Dry and mild",
  },
  {
    icon: "clock",
    label: "Recommended Days",
    value: "7 days",
    note: "Minimum 5 for the essentials",
  },
  {
    icon: "wallet",
    label: "Daily Budget",
    value: "CNY 200-700",
    note: "Backpacker to mid-range",
  },
  {
    icon: "mountain",
    label: "Altitude",
    value: "0-1,100m",
    note: "No acclimatization needed",
  },
];
---
<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-px overflow-hidden rounded-xl border border-stone-200 bg-stone-200 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((f) => (
        <div class="bg-white p-6">
          <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-stone-400">
            {f.icon === "calendar" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>}
            {f.icon === "clock" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
            {f.icon === "wallet" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>}
            {f.icon === "mountain" && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3l4 8 5-5 5 15H2L8 3z"/></svg>}
            {f.label}
          </p>
          <p class="mt-1.5 font-semibold text-stone-900">{f.value}</p>
          <p class="text-xs text-stone-400 mt-0.5">{f.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>
