---
import { SITE } from "../data/config";
---
<section class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Who wrote this, and why you can trust it
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8 bg-stone-50 rounded-2xl border border-stone-200 p-8 flex flex-col sm:flex-row gap-6">
        <div class="shrink-0 w-20 h-20 rounded-full bg-brand-700 flex items-center justify-center text-white font-bold text-2xl">
          GX
        </div>
        <div>
          <p class="text-lg font-bold text-stone-900">{SITE.author.name}</p>
          <p class="text-sm text-brand-700 font-medium mt-0.5">{SITE.author.jobTitle}</p>
          <p class="text-stone-600 text-sm mt-3 leading-relaxed">
            {SITE.author.bio} We earn no commission on anything you book, and we do not accept payment for listings.
          </p>
        </div>
      </div>

      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="bg-white rounded-2xl border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-900">Sources for the facts</p>
          <ul class="mt-3 space-y-2 text-xs text-stone-500 leading-relaxed">
            <li>Population and area: Guangxi Statistical Yearbook, 2023</li>
            <li>Visa policy: National Immigration Administration, 2025</li>
            <li>Prices and transport: on-the-ground checks, 2026</li>
          </ul>
        </div>
        <div class="bg-white rounded-2xl border border-stone-200 p-6">
          <p class="text-sm font-semibold text-stone-900">Last updated</p>
          <p class="text-sm text-stone-600 mt-2">August 2026, with 2026 pricing.</p>
          <p class="text-xs text-stone-400 mt-2">Prices and visa rules change. We review this page quarterly.</p>
        </div>
      </div>
    </div>
  </div>
</section>
